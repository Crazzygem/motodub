# Copy to .env and fill in real values. Never commit the real .env.
PORT=3000
DB_NAME=motodub
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
JWT_SECRET=replace-with-a-long-random-hex
# FCM (Task 4.7): path to the Firebase service-account JSON. Left empty the
# server logs "FCM not configured — push disabled" once and skips all pushes.
FIREBASE_SERVICE_ACCOUNT=
