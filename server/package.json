{
  "name": "motodub-server",
  "version": "1.0.0",
  "description": "MotoDub API — Express + Socket.IO + Sequelize (MySQL)",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "migrate": "sequelize db:migrate --config src/config/config.js --models-path src/models --migrations-path migrations --seeders-path seeders",
    "seed": "node src/seeders/seed.js",
    "seed:reset": "node src/seeders/seed.js --reset",
    "db:check": "node src/scripts/dbcheck.js",
    "bots": "node scripts/bots.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
